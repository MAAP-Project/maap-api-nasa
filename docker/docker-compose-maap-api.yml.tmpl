version: '3.8'
services:
  api:
    container_name: 'maap-api-nasa'
    image: ${API_IMAGE_NAME}
    ports:
      - "5000:5000"
    volumes:
      - ./logs:/maap-api-nasa/logs/
    command: >
      sh -c "gunicorn -c gunicorn.conf.py api.maapapp:app"
    env_file:
      - .maap-api.env
    restart: always
